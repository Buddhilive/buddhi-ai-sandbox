{
  "name": "buddhi-ai-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side Node.js sandbox running entirely in WebAssembly & Web Workers",
  "scripts": {
    "build": "pnpm -r --filter=!sandbox-demo run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter=@buddhilive/sandbox run test:unit",
    "test:e2e": "pnpm --filter=@buddhilive/sandbox run test:e2e",
    "dev": "pnpm --filter=sandbox-demo run dev",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
